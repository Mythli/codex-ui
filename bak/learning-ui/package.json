{
  "name": "@taylordb/learning-ui",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "ladle serve",
    "build": "tsup",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "test": "vitest run",
    "dev:demo": "vite dev -c vite.demo.config.ts",
    "build:demo": "vite build -c vite.demo.config.ts",
    "start:demo": "NODE_ENV=production node .output/server/index.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@uiw/react-md-editor": "^4.1.0",
    "fabric": "^7.3.1",
    "mathjs": "^13.2.3",
    "openai": "^6.37.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-icons": "^5.6.0",
    "react-markdown": "^9.1.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ladle/react": "^4.1.2",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/react-start-plugin": "^1.131.50",
    "@taylordb/learning-backend": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "api": "link:@tanstack/react-start/api",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^24.1.3",
    "llm-fns": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.1",
    "tsup": "^8.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
