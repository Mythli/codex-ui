{
  "name": "@taylordb/codex",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dump:e2e": "tsx scripts/dump-e2e-scenario.ts",
    "generate:protocol-types": "/Applications/Codex.app/Contents/Resources/codex app-server generate-ts --experimental --out src/protocol/generated/app-server",
    "lint": "oxlint src scripts tsdown.config.ts",
    "lint:fix": "oxlint --fix src scripts tsdown.config.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e:capture": "pnpm run dump:e2e"
  },
  "dependencies": {
    "immer": "^11.1.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
