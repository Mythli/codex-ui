{
  "name": "codex-api-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @taylordb/coder dev",
    "start": "pnpm --filter @taylordb/coder start",
    "dev:e2e": "pnpm --filter @taylordb/coder dev:e2e",
    "storybook": "pnpm --filter @taylordb/coder storybook",
    "build": "pnpm -r --if-present build",
    "codex:e2e:dump": "pnpm --filter @taylordb/codex dump:e2e",
    "codex:e2e:capture": "pnpm --filter @taylordb/codex test:e2e:capture",
    "test:e2e:click": "pnpm --filter @taylordb/coder test:e2e:click",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:tsc": "pnpm -r --if-present typecheck:tsc",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "pnpm --filter @taylordb/codex test"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.0",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "oxlint": "^1.66.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2"
  }
}
