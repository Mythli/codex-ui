{
  "name": "codex-api-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @taylordb/coder dev",
    "dev:e2e": "pnpm --filter @taylordb/coder dev:e2e",
    "dev:start": "pnpm --filter @taylordb/coder dev:start",
    "dev:stop": "pnpm --filter @taylordb/coder dev:stop",
    "dev:restart": "pnpm --filter @taylordb/coder dev:restart",
    "dev:status": "pnpm --filter @taylordb/coder dev:status",
    "dev:logs": "pnpm --filter @taylordb/coder dev:logs",
    "dev:tail": "pnpm --filter @taylordb/coder dev:tail",
    "dev:attach": "pnpm --filter @taylordb/coder dev:attach",
    "storybook": "pnpm --filter @taylordb/coderui dev",
    "storybook:start": "pnpm --filter @taylordb/coderui dev:start",
    "storybook:stop": "pnpm --filter @taylordb/coderui dev:stop",
    "storybook:restart": "pnpm --filter @taylordb/coderui dev:restart",
    "storybook:status": "pnpm --filter @taylordb/coderui dev:status",
    "storybook:logs": "pnpm --filter @taylordb/coderui dev:logs",
    "storybook:tail": "pnpm --filter @taylordb/coderui dev:tail",
    "storybook:attach": "pnpm --filter @taylordb/coderui dev:attach",
    "build": "pnpm -r --if-present build",
    "codex:e2e:dump": "pnpm --filter @taylordb/codex dump:e2e",
    "codex:e2e:capture": "pnpm --filter @taylordb/codex test:e2e:capture",
    "test:e2e:click": "pnpm --filter @taylordb/coder test:e2e:click",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @taylordb/codex test"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
